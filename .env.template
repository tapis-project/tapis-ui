VITE_SERVERLESS_DEPLOYMENT = "false"
## Customize base_url to access Tapis APIs
# Ensure there is no ending slash!
VITE_TAPIS_BASE_URL = "https://dev.develop.tapis.io"
#VITE_TAPIS_BASE_URL = "https://tacc.develop.tapis.io"

# MLHub Base URL
VITE_MLHUB_BASE_URL="https://dev.develop.tapis.io"

# Dev-only: point ONLY the Pods service at a local Pods service. The dev
# server proxies /v3/pods to this target same-origin (no CORS); the request reaches the service as
# "localhost", so tapisservice resolves your tenant from the token (its local-dev path), no Host
# rewrite needed. See vite/vite.config.mts + src/utils/resolvePodsBasePath.ts. Login and every other
# service keep using VITE_TAPIS_BASE_URL. Restart `pnpm dev` after changing.
#VITE_PODS_BASE_URL = "http://localhost:8080"

### Re-run pnpm start or pnpm dev to apply changes to base_url

# Comma-separated usernames the Settings page treats as tenant/site admins,
# until SK role checks replace the stopgap roster. Empty means only the
# tenant's own admin_user. UI gating only — the services still authorize.
VITE_SETTINGS_ADMINS = ""
